Options -Indexes
DirectorySlash Off
<FilesMatch "^(config\.php|Dockerfile|render\.yaml|README\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </Files>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# Redirection HTTPS (Render termine le SSL en amont)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
  # URLs propres : /contact au lieu de /contact.php
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.php[\s?]
  RewriteRule ^(.*/)?index\.php$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/(.+)\.php[\s?]
  RewriteRule ^(.+)\.php$ https://%{HTTP_HOST}/$1 [R=301,L]
  # dossier sans slash final (ex. /admin) -> /admin/ sans port interne
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Performance : compression + cache navigateur
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
